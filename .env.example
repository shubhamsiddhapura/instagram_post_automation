# ========================================================
# MomaiDham Automation: WhatsApp Group to Instagram Reels
# ========================================================

# ----------------- WhatsApp Configuration -----------------
# Target WhatsApp Group JID (e.g., 120363028392183921@g.us)
# Run "npm run wa:groups" to scan QR code and view your group IDs!
TARGET_WHATSAPP_GROUP_JID=

# WhatsApp session folder path
WA_SESSION_DIR=./wa-session

# Optional: If you prefer entering an 8-digit pairing code on your phone instead of QR scanning,
# enter your full phone number with country code (e.g. 919876543210). Leave empty to use QR code.
WA_PAIRING_PHONE_NUMBER=

# ----------------- Instagram Configuration ----------------
# Direct login credentials for your Instagram account
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Path to cached Instagram session
IG_SESSION_FILE=./ig_session.json

# Optional: HTTP/HTTPS proxy if needed (format: http://user:pass@host:port)
IG_PROXY=

# ----------------- Reel Video Settings --------------------
# Length of the generated Reel in seconds (recommended: 7 - 15 seconds)
REEL_DURATION_SECONDS=15

# Path to folder containing background MP3 music
MUSIC_DIR=./assets/music

# Video Canvas Size (Instagram Reels standard is 1080x1920)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# ----------------- Safety & Automation Flags --------------
# Set to "true" to upload automatically to Instagram.
# Set to "false" to only download & generate Reels locally (for testing).
ENABLE_AUTO_UPLOAD=true

# Delete temporary image & video files after successful upload
DELETE_TEMP_AFTER_UPLOAD=false
