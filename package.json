{
  "name": "momaidham-automation",
  "version": "1.0.0",
  "description": "WhatsApp Group to Instagram Reels Automation Pipeline",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "wa:scan": "tsx scripts/scan-wa-qr.ts",
    "wa:groups": "tsx scripts/scan-wa-qr.ts --list-groups",
    "ig:login": "python src/instagram/ig_bridge.py --login-only",
    "ig:music": "tsx scripts/search-insta-music.ts",
    "test:video": "tsx scripts/test-video.ts",
    "test:pipeline": "tsx scripts/test-pipeline.ts",
    "post:last": "tsx scripts/post-last-image.ts",
    "postinstall": "node scripts/patch-baileys.js"
  },
  "keywords": [
    "whatsapp",
    "instagram",
    "reels",
    "baileys",
    "automation",
    "ffmpeg"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "p-queue": "^6.6.2",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
